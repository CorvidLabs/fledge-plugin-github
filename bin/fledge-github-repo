#!/usr/bin/env bash
# fledge-github-repo — read GitHub repo metadata and file contents via gh.
# Invoked via: fledge github repo [view | file <path>] [OPTIONS]
#
# `view` returns the current repo's metadata (default-branch, description,
# topics, etc.). `file <path>` reads a file from a remote repo at an
# optional ref — wraps `gh api` against /repos/{owner}/{repo}/contents/...
# Closes the gap where agents kept trying to web-fetch
# https://raw.githubusercontent.com/... and failing on auth/redirects.
set -euo pipefail

ACTION="view"
REPO=""
REF=""
PATH_ARG=""
JSON=false

if [ $# -gt 0 ] && [ "${1:0:1}" != "-" ]; then
  case "$1" in
    view)
      ACTION="view"
      shift
      ;;
    file)
      ACTION="file"
      shift
      if [ $# -gt 0 ] && [ "${1:0:1}" != "-" ]; then
        PATH_ARG="$1"
        shift
      fi
      ;;
  esac
fi

while [ $# -gt 0 ]; do
  case "$1" in
    -R|--repo)   REPO="${2:-}"; shift 2;;
    -r|--ref)    REF="${2:-}"; shift 2;;
    --json)      JSON=true; shift;;
    -h|--help)
      cat <<'EOF'
fledge github repo — read repo metadata and file contents via the gh CLI

USAGE:
  fledge github repo [view]                      View repo metadata (default)
  fledge github repo file <PATH>                 Read a file from the repo

OPTIONS:
  -R, --repo <OWNER/NAME>   Target repo (default: current working repo)
  -r, --ref <REF>           Branch / tag / SHA (file only; default: repo default)
      --json                Output JSON

EXAMPLES:
  fledge github repo
  fledge github repo view -R CorvidLabs/merlin
  fledge github repo file CHANGELOG.md
  fledge github repo file README.md -R CorvidLabs/fledge-plugin-github
  fledge github repo file Cargo.toml -r v0.3.0
EOF
      exit 0
      ;;
    *)
      echo "fledge github repo: unknown argument '$1'" >&2
      exit 64
      ;;
  esac
done

if ! command -v gh >/dev/null 2>&1; then
  echo "fledge github repo: gh CLI is not installed. https://cli.github.com/" >&2
  exit 127
fi

if [ "$ACTION" = "view" ]; then
  # ${ARRAY[@]+...} expansion: with `set -u`, "${EMPTY[@]}" errors on
  # bash < 4.4. Use the +-form so the expansion only happens when the
  # array is non-empty.
  if [ "$JSON" = "true" ]; then
    if [ -n "$REPO" ]; then
      gh repo view "$REPO" --json name,nameWithOwner,description,url,defaultBranchRef,isPrivate,isFork,isArchived,visibility,pushedAt,languages
    else
      gh repo view --json name,nameWithOwner,description,url,defaultBranchRef,isPrivate,isFork,isArchived,visibility,pushedAt,languages
    fi
  else
    if [ -n "$REPO" ]; then
      gh repo view "$REPO"
    else
      gh repo view
    fi
  fi
  exit 0
fi

if [ "$ACTION" = "file" ]; then
  if [ -z "$PATH_ARG" ]; then
    echo "fledge github repo: 'file' requires a path. Try: fledge github repo file README.md" >&2
    exit 64
  fi

  # Resolve owner/name. If --repo wasn't passed, ask gh to figure it
  # out from the current working dir. Bail with a clear error rather
  # than silently 404ing if we're not in a repo and no -R was given.
  if [ -z "$REPO" ]; then
    REPO="$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)"
    if [ -z "$REPO" ]; then
      echo "fledge github repo file: --repo not given and current directory isn't a gh-recognized repo." >&2
      exit 64
    fi
  fi

  # Build the contents API endpoint with optional ?ref=<REF>.
  ENDPOINT="repos/${REPO}/contents/${PATH_ARG}"
  if [ -n "$REF" ]; then
    ENDPOINT="${ENDPOINT}?ref=${REF}"
  fi

  if [ "$JSON" = "true" ]; then
    # Pass through the raw API response — caller decodes content
    # themselves if they want the base64.
    gh api "$ENDPOINT"
  else
    # Default: emit just the decoded file contents. The contents API
    # returns base64-encoded content for files; the .content field
    # holds it with embedded newlines that base64(1) tolerates.
    gh api "$ENDPOINT" --jq '.content' | base64 -d
  fi
  exit 0
fi
