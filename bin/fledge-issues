#!/usr/bin/env bash
# fledge-issues — list and view GitHub issues via the gh CLI.
# Invoked via: fledge issues [view <num> | list] [OPTIONS]
set -euo pipefail

ACTION="list"
NUMBER=""
STATE="open"
LIMIT="20"
LABEL=""
JSON=false

# First positional arg can be a subcommand: view or list
if [ $# -gt 0 ] && [ "${1:0:1}" != "-" ]; then
  case "$1" in
    view)
      ACTION="view"
      shift
      if [ $# -gt 0 ] && [ "${1:0:1}" != "-" ]; then
        NUMBER="$1"
        shift
      fi
      ;;
    list)
      ACTION="list"
      shift
      ;;
  esac
fi

while [ $# -gt 0 ]; do
  case "$1" in
    -s|--state)    STATE="${2:-}"; shift 2;;
    -l|--limit)    LIMIT="${2:-}"; shift 2;;
    --label)       LABEL="${2:-}"; shift 2;;
    --json)        JSON=true; shift;;
    -h|--help)
      cat <<'EOF'
fledge issues — list and view GitHub issues

USAGE:
  fledge issues [list]                List open issues (default)
  fledge issues view <NUMBER>         View a specific issue

OPTIONS:
  -s, --state <STATE>   open | closed | all  (default: open)
  -l, --limit <N>       Maximum results (default: 20)
      --label <LABEL>   Filter by label
      --json            Output JSON

EXAMPLES:
  fledge issues
  fledge issues --state all --limit 50
  fledge issues view 42 --json
EOF
      exit 0
      ;;
    *)
      echo "fledge-issues: unknown argument '$1'" >&2
      exit 64
      ;;
  esac
done

if ! command -v gh >/dev/null 2>&1; then
  echo "fledge-issues: gh CLI is not installed. https://cli.github.com/" >&2
  exit 127
fi

if [ "$ACTION" = "view" ]; then
  if [ -z "$NUMBER" ]; then
    echo "fledge-issues: 'view' requires an issue number. Try: fledge issues view 42" >&2
    exit 64
  fi
  if [ "$JSON" = "true" ]; then
    gh issue view "$NUMBER" --json number,title,state,author,body,labels,createdAt,updatedAt,url,assignees
  else
    gh issue view "$NUMBER"
  fi
  exit 0
fi

# list
ARGS=(--state "$STATE" --limit "$LIMIT")
if [ -n "$LABEL" ]; then ARGS+=(--label "$LABEL"); fi

if [ "$JSON" = "true" ]; then
  gh issue list "${ARGS[@]}" --json number,title,state,labels,author,createdAt,url
else
  gh issue list "${ARGS[@]}"
fi
