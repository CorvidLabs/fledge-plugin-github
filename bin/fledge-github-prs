#!/usr/bin/env bash
# fledge-github-prs — list, view, create, comment on, review, merge, close,
# and reopen GitHub pull requests via the gh CLI.
# Invoked via: fledge github prs [list | view <num> | create | comment <num> |
#   review <num> | merge <num> | close <num> | reopen <num>] [OPTIONS]
set -euo pipefail

ACTION="list"
NUMBER=""
STATE="open"
LIMIT="20"
TITLE=""
BODY=""
BASE=""
DRAFT=false
FILL=false
JSON=false
AI=false
INCLUDE_DIFF=false
INCLUDE_COMMENTS=false
MERGE_METHOD="squash"
REVIEW_KIND=""
REPO=""
HEAD_BRANCH=""

# When -R/--repo is set, every gh sub-call gets `--repo $REPO`
# appended via REPO_FLAGS. Empty when -R isn't set, so the gh CLI
# falls back to its normal cwd-based repo detection.
REPO_FLAGS=()

# ANSI color codes
BLUE=$'\033[0;34m'
BOLD=$'\033[1m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

# Parse positional subcommand. `view`, `comment`, `review`, `merge`, `close`,
# and `reopen` all take a number; `create` and `list` don't.
if [ $# -gt 0 ] && [ "${1:0:1}" != "-" ]; then
  case "$1" in
    view|comment|review|merge|close|reopen)
      ACTION="$1"
      shift
      if [ $# -gt 0 ] && [ "${1:0:1}" != "-" ]; then
        NUMBER="$1"
        shift
      fi
      ;;
    create)
      ACTION="create"
      shift
      ;;
    list)
      ACTION="list"
      shift
      ;;
  esac
fi

while [ $# -gt 0 ]; do
  case "$1" in
    -s|--state)         STATE="${2:-}"; shift 2;;
    -l|--limit)         LIMIT="${2:-}"; shift 2;;
    -t|--title)         TITLE="${2:-}"; shift 2;;
    -b|--body)          BODY="${2:-}"; shift 2;;
    --base)             BASE="${2:-}"; shift 2;;
    --draft)            DRAFT=true; shift;;
    --fill)             FILL=true; shift;;
    --json)             JSON=true; shift;;
    --ai)               AI=true; shift;;
    --diff)             INCLUDE_DIFF=true; shift;;
    --comments)         INCLUDE_COMMENTS=true; shift;;
    --squash)           MERGE_METHOD="squash"; shift;;
    --merge)            MERGE_METHOD="merge"; shift;;
    --rebase)           MERGE_METHOD="rebase"; shift;;
    --approve)          REVIEW_KIND="approve"; shift;;
    --request-changes)  REVIEW_KIND="request-changes"; shift;;
    --comment-review)   REVIEW_KIND="comment"; shift;;
    -R|--repo)          REPO="${2:-}"; shift 2;;
    -H|--head)          HEAD_BRANCH="${2:-}"; shift 2;;
    -h|--help)
      cat <<'EOF'
fledge github prs — manage GitHub pull requests via the gh CLI

USAGE:
  fledge github prs [list]                          List open PRs (default)
  fledge github prs view <NUMBER>                   View a specific PR
  fledge github prs create                          Create a new PR
  fledge github prs comment <NUMBER> -b BODY        Post a comment
  fledge github prs review <NUMBER> ...             Submit a review
  fledge github prs merge <NUMBER> [--squash|...]   Merge the PR
  fledge github prs close <NUMBER>                  Close without merging
  fledge github prs reopen <NUMBER>                 Reopen a closed PR

LIST / VIEW OPTIONS:
  -s, --state <STATE>   open | closed | merged | all  (default: open)
  -l, --limit <N>       Maximum results (default: 20)
      --json            Output JSON
      --diff            (view) Append the unified diff
      --comments        (view) Append PR conversation comments + reviews

CREATE OPTIONS:
  -t, --title <TITLE>   PR title
  -b, --body <BODY>     PR body
      --base <BRANCH>   Base branch (default: repo default)
  -H, --head <BRANCH>   Head branch to PR from (default: current local branch).
                        Required when -R targets a repo that isn't your cwd.
      --draft           Open as draft PR
      --fill            Infer title/body from commits
      --ai              Generate title and body using AI (fledge ask)
      --json            Output JSON (number, url, title)

COMMENT OPTIONS:
  -b, --body <BODY>     Comment body (required)
      --json            Output JSON (url)

REVIEW OPTIONS:
  One of:
      --approve           Approve the PR
      --request-changes   Request changes (requires --body)
      --comment-review    Submit a review-comment (no approval/blocking)
  -b, --body <BODY>     Review body (required for --request-changes /
                        --comment-review, optional for --approve)

MERGE OPTIONS:
      --squash          Squash-merge (default)
      --merge           Merge commit
      --rebase          Rebase-merge

EXAMPLES:
  fledge github prs
  fledge github prs --state merged --limit 5
  fledge github prs view 256 --diff --comments
  fledge github prs create --fill
  fledge github prs comment 256 -b "Looks good — one nit inline."
  fledge github prs review 256 --approve
  fledge github prs review 256 --request-changes -b "See comments."
  fledge github prs merge 256 --squash
  fledge github prs close 256
EOF
      exit 0
      ;;
    *)
      echo "fledge github prs: unknown argument '$1'" >&2
      exit 64
      ;;
  esac
done

if ! command -v gh >/dev/null 2>&1; then
  echo "fledge github prs: gh CLI is not installed. https://cli.github.com/" >&2
  exit 127
fi

# Expand --repo into the gh flag form. Done once here so every action
# branch can splice "${REPO_FLAGS[@]+...}" into its gh invocation
# without re-checking $REPO.
if [ -n "$REPO" ]; then
  REPO_FLAGS=(--repo "$REPO")
fi

# All non-list actions except 'create' need a number.
case "$ACTION" in
  view|comment|review|merge|close|reopen)
    if [ -z "$NUMBER" ]; then
      echo "fledge github prs: '$ACTION' requires a PR number. Try: fledge github prs $ACTION 256" >&2
      exit 64
    fi
    ;;
esac

if [ "$ACTION" = "view" ]; then
  if [ "$JSON" = "true" ]; then
    gh pr view "$NUMBER" "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}" --json number,title,state,author,body,labels,createdAt,updatedAt,url,baseRefName,headRefName,isDraft,mergeable,statusCheckRollup
  else
    gh pr view "$NUMBER" "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}"
  fi
  # Optional appendices below the main view block. Each section is
  # gated by its own flag and separated by a blank line so the output
  # reads like a single document. `--json` skips both — JSON callers
  # should fetch what they need with structured calls instead of
  # parsing concatenated streams.
  if [ "$JSON" != "true" ] && [ "$INCLUDE_COMMENTS" = "true" ]; then
    printf '\n--- Comments + Reviews ---\n'
    gh pr view "$NUMBER" "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}" --comments
  fi
  if [ "$JSON" != "true" ] && [ "$INCLUDE_DIFF" = "true" ]; then
    printf '\n--- Diff ---\n'
    gh pr diff "$NUMBER" "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}"
  fi
  exit 0
fi

if [ "$ACTION" = "comment" ]; then
  if [ -z "$BODY" ]; then
    echo "fledge github prs: 'comment' requires --body" >&2
    exit 64
  fi
  if [ "$JSON" = "true" ]; then
    # gh pr comment prints the comment URL to stdout when -b is used;
    # wrap that in a tiny JSON shape so callers can parse it uniformly.
    URL="$(gh pr comment "$NUMBER" "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}" -b "$BODY")"
    printf '{"url":"%s"}\n' "$URL"
  else
    gh pr comment "$NUMBER" "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}" -b "$BODY"
  fi
  exit 0
fi

if [ "$ACTION" = "review" ]; then
  if [ -z "$REVIEW_KIND" ]; then
    echo "fledge github prs: 'review' requires --approve, --request-changes, or --comment-review" >&2
    exit 64
  fi
  if [ "$REVIEW_KIND" != "approve" ] && [ -z "$BODY" ]; then
    echo "fledge github prs: '--$REVIEW_KIND' requires --body" >&2
    exit 64
  fi
  ARGS=("$NUMBER")
  [ -n "$REPO" ] && ARGS+=(--repo "$REPO")
  case "$REVIEW_KIND" in
    approve)         ARGS+=(--approve);;
    request-changes) ARGS+=(--request-changes);;
    comment)         ARGS+=(--comment);;
  esac
  [ -n "$BODY" ] && ARGS+=(--body "$BODY")
  gh pr review "${ARGS[@]}"
  exit 0
fi

if [ "$ACTION" = "merge" ]; then
  case "$MERGE_METHOD" in
    squash) gh pr merge "$NUMBER" "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}" --squash;;
    merge)  gh pr merge "$NUMBER" "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}" --merge;;
    rebase) gh pr merge "$NUMBER" "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}" --rebase;;
  esac
  exit 0
fi

if [ "$ACTION" = "close" ]; then
  gh pr close "$NUMBER" "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}"
  exit 0
fi

if [ "$ACTION" = "reopen" ]; then
  gh pr reopen "$NUMBER" "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}"
  exit 0
fi

if [ "$ACTION" = "create" ]; then

  if [ "$AI" = "true" ]; then
    # Check fledge is available; fall back gracefully if not
    if ! command -v fledge >/dev/null 2>&1; then
      echo "fledge github prs: warning: 'fledge' not found on PATH — skipping AI generation." >&2
      AI=false
    fi
  fi

  if [ "$AI" = "true" ]; then
    # Detect base branch
    DETECTED_BASE=""
    if [ -n "$BASE" ]; then
      DETECTED_BASE="$BASE"
    else
      DETECTED_BASE="$(gh repo view --json defaultBranchRef --jq '.defaultBranchRef.name' 2>/dev/null || true)"
      if [ -z "$DETECTED_BASE" ]; then
        DETECTED_BASE="main"
      fi
    fi

    # Get current branch
    CURRENT_BRANCH="$(git branch --show-current 2>/dev/null || true)"
    if [ -z "$CURRENT_BRANCH" ]; then
      echo "fledge github prs: could not determine current branch." >&2
      exit 1
    fi

    # Collect git context
    COMMITS="$(git log "${DETECTED_BASE}..HEAD" --oneline 2>/dev/null | head -30 || true)"
    if [ -z "$COMMITS" ]; then
      echo "fledge github prs: no commits found between '${DETECTED_BASE}' and HEAD. Nothing to create a PR from." >&2
      exit 1
    fi

    DIFF_STAT="$(git diff "${DETECTED_BASE}..HEAD" --stat 2>/dev/null || true)"
    DIFF_FULL="$(git diff "${DETECTED_BASE}..HEAD" 2>/dev/null || true)"
    # Truncate diff to ~4000 chars
    DIFF_TRUNCATED="${DIFF_FULL:0:4000}"
    if [ "${#DIFF_FULL}" -gt 4000 ]; then
      DIFF_TRUNCATED="${DIFF_TRUNCATED}
... (diff truncated)"
    fi

    # Build prompt
    AI_PROMPT="You are helping write a GitHub pull request.

Branch: ${CURRENT_BRANCH}
Base: ${DETECTED_BASE}

Commits:
${COMMITS}

Diff stat:
${DIFF_STAT}

Diff (truncated):
${DIFF_TRUNCATED}

Write a pull request title and body for this branch.

Rules:
- Line 1: the PR title only — plain text, no markdown heading prefix (no leading # or *)
- Line 2: blank
- Lines 3+: the PR body in markdown (summary, motivation, key changes; use bullet points where helpful)

Output only the title and body. No preamble, no meta-commentary."

    echo "Generating PR title and body with AI..." >&2

    AI_OUTPUT="$(fledge ask --no-spec-index "$AI_PROMPT" 2>/dev/null || true)"

    if [ -z "$AI_OUTPUT" ]; then
      echo "fledge github prs: AI generation returned empty output. Continuing without AI." >&2
      AI=false
    fi
  fi

  if [ "$AI" = "true" ]; then
    # Parse: TITLE = first line stripped of leading # and spaces
    AI_TITLE="$(printf '%s\n' "$AI_OUTPUT" | head -1 | sed 's/^[# ]*//')"
    # BODY = everything from line 3+
    AI_BODY="$(printf '%s\n' "$AI_OUTPUT" | tail -n +3)"

    # Only fill in what the user did not already provide
    if [ -z "$TITLE" ]; then
      TITLE="$AI_TITLE"
    fi
    if [ -z "$BODY" ]; then
      BODY="$AI_BODY"
    fi

    # Interactive review loop (reads from /dev/tty for non-interactive safety)
    while true; do
      # Show colored preview box
      printf '\n'
      printf '%s╔══════════════════════════════════════════════════════════╗%s\n' "$BLUE" "$RESET"
      printf '%s║%s  %sPR Preview%s\n' "$BLUE" "$RESET" "$BOLD" "$RESET"
      printf '%s╠══════════════════════════════════════════════════════════╣%s\n' "$BLUE" "$RESET"
      printf '%s║%s  %sTitle:%s %s\n' "$BLUE" "$RESET" "$BOLD" "$RESET" "$TITLE"
      printf '%s╠══════════════════════════════════════════════════════════╣%s\n' "$BLUE" "$RESET"
      printf '%s║%s  %sBody:%s\n' "$BLUE" "$RESET" "$BOLD" "$RESET"
      while IFS= read -r bline; do
        printf '%s║%s  %s\n' "$BLUE" "$RESET" "$bline"
      done <<< "$BODY"
      printf '%s╚══════════════════════════════════════════════════════════╝%s\n' "$BLUE" "$RESET"
      printf '\n'

      printf '%s[c]%sonfirm  %s[e]%sdit  %s[a]%sbort > ' "$YELLOW" "$RESET" "$YELLOW" "$RESET" "$YELLOW" "$RESET"
      CHOICE=""
      read -r CHOICE </dev/tty || true
      CHOICE="${CHOICE:-c}"

      case "$CHOICE" in
        c|confirm|"")
          break
          ;;
        e|edit)
          TMPFILE="$(mktemp /tmp/fledge-pr-XXXXXX.md)"
          printf '%s\n\n%s\n' "$TITLE" "$BODY" > "$TMPFILE"
          "${EDITOR:-vi}" "$TMPFILE" </dev/tty >/dev/tty
          # Re-read title/body from file
          NEW_TITLE="$(head -1 "$TMPFILE" | sed 's/^[# ]*//')"
          # Body = everything from line 3+
          NEW_BODY="$(tail -n +3 "$TMPFILE")"
          rm -f "$TMPFILE"
          TITLE="$NEW_TITLE"
          BODY="$NEW_BODY"
          # Loop back to show updated preview
          ;;
        a|abort)
          echo "Aborted."
          exit 0
          ;;
        *)
          printf "Unknown choice '%s'. Enter c, e, or a.\n" "$CHOICE" >&2
          ;;
      esac
    done
  fi

  # Build gh pr create argument list
  ARGS=()
  [ -n "$REPO" ]        && ARGS+=(--repo "$REPO")
  [ -n "$TITLE" ]       && ARGS+=(--title "$TITLE")
  [ -n "$BODY" ]        && ARGS+=(--body "$BODY")
  [ -n "$BASE" ]        && ARGS+=(--base "$BASE")
  [ -n "$HEAD_BRANCH" ] && ARGS+=(--head "$HEAD_BRANCH")
  [ "$DRAFT" = "true" ] && ARGS+=(--draft)
  [ "$FILL" = "true" ]  && ARGS+=(--fill)
  if [ "$JSON" = "true" ]; then
    # gh pr create has no --json flag (only list/view do); it prints the
    # new PR's URL on stdout on success. Parse the number out of that URL
    # and fetch the authoritative shape from gh pr view instead.
    PR_URL="$(gh pr create "${ARGS[@]}" | tail -n1)"
    PR_NUMBER="${PR_URL##*/}"
    gh pr view "$PR_NUMBER" "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}" --json number,url,title
  else
    gh pr create "${ARGS[@]}"
  fi
  exit 0
fi

# list
if [ "$JSON" = "true" ]; then
  gh pr list "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}" --state "$STATE" --limit "$LIMIT" \
    --json number,title,state,author,createdAt,url,baseRefName,headRefName,isDraft,labels
else
  gh pr list "${REPO_FLAGS[@]+"${REPO_FLAGS[@]}"}" --state "$STATE" --limit "$LIMIT"
fi
