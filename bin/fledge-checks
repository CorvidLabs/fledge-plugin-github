#!/usr/bin/env bash
# fledge-checks — view CI/CD check status for a branch via the gh CLI.
# Invoked via: fledge checks [--branch <name>] [--json]
#
# Replaces the pre-v0.15 in-core `fledge checks` command. Same flags, same
# JSON shape as before so existing scripts keep working.
set -euo pipefail

BRANCH=""
JSON=false

while [ $# -gt 0 ]; do
  case "$1" in
    -b|--branch)
      BRANCH="${2:-}"
      shift 2
      ;;
    --json)
      JSON=true
      shift
      ;;
    -h|--help)
      cat <<'EOF'
fledge checks — view CI/CD check status for a branch

USAGE:
  fledge checks [OPTIONS]

OPTIONS:
  -b, --branch <NAME>  Branch to check (default: current branch)
      --json           Output raw GitHub API response as JSON
  -h, --help           Show this help

EXAMPLES:
  fledge checks
  fledge checks --branch main
  fledge checks --json | jq '.check_runs[].name'
EOF
      exit 0
      ;;
    *)
      echo "fledge-checks: unknown argument '$1'" >&2
      exit 64
      ;;
  esac
done

if ! command -v gh >/dev/null 2>&1; then
  echo "fledge-checks: gh CLI is not installed. https://cli.github.com/" >&2
  exit 127
fi

if [ -z "$BRANCH" ]; then
  BRANCH="$(git branch --show-current 2>/dev/null || true)"
  if [ -z "$BRANCH" ]; then
    echo "fledge-checks: not on a branch (detached HEAD?). Use --branch <name>." >&2
    exit 65
  fi
fi

REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)"
if [ -z "$REPO" ]; then
  echo "fledge-checks: could not detect GitHub repo. Run 'gh auth login' and ensure 'origin' points at a GitHub remote." >&2
  exit 1
fi

DATA="$(gh api "repos/${REPO}/commits/${BRANCH}/check-runs" --paginate=false 2>/dev/null || true)"
if [ -z "$DATA" ]; then
  echo "fledge-checks: failed to fetch check runs for ${REPO}@${BRANCH}." >&2
  exit 1
fi

if [ "$JSON" = "true" ]; then
  printf '%s\n' "$DATA"
  exit 0
fi

COUNT="$(printf '%s' "$DATA" | jq '.check_runs | length')"
if [ "$COUNT" = "0" ]; then
  printf '* No CI checks found for branch %s\n' "$BRANCH"
  exit 0
fi

printf '* CI checks for %s:\n\n' "$BRANCH"

printf '%s' "$DATA" | jq -r '
  .check_runs[] |
  [
    (
      if .status == "completed" then
        if .conclusion == "success" then "✅"
        elif .conclusion == "failure" then "❌"
        elif .conclusion == "cancelled" then "🚫"
        elif .conclusion == "skipped" then "⏭️"
        else "⚠️"
        end
      else "🔄"
      end
    ),
    .name,
    (
      if .status == "completed" then (.conclusion // "completed")
      else .status
      end
    ),
    (
      if (.started_at and .completed_at) then
        ((.completed_at | fromdateiso8601) - (.started_at | fromdateiso8601)) as $secs |
        if $secs < 60 then "\($secs)s"
        else "\(($secs / 60) | floor)m \($secs % 60)s"
        end
      else ""
      end
    )
  ] | @tsv
' | awk -F'\t' '
  { printf "  %s %-40s %-10s %s\n", $1, $2, $3, $4 }
'

PASSED="$(printf '%s' "$DATA" | jq '[.check_runs[] | select(.status == "completed" and (.conclusion == "success" or .conclusion == "skipped"))] | length')"
FAILED="$(printf '%s' "$DATA" | jq '[.check_runs[] | select(.status == "completed" and (.conclusion == "failure" or .conclusion == "cancelled"))] | length')"
PENDING="$(printf '%s' "$DATA" | jq '[.check_runs[] | select(.status != "completed")] | length')"

printf '\n  %s checks: ' "$COUNT"
SEP=""
if [ "$PASSED" -gt 0 ]; then printf '%s%s passed' "$SEP" "$PASSED"; SEP=", "; fi
if [ "$FAILED" -gt 0 ]; then printf '%s%s failed' "$SEP" "$FAILED"; SEP=", "; fi
if [ "$PENDING" -gt 0 ]; then printf '%s%s pending' "$SEP" "$PENDING"; SEP=", "; fi
printf '\n'
